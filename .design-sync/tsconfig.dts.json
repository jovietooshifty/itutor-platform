{
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../dist/types",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] },
    "jsx": "preserve",
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [],
    "lib": ["dom", "dom.iterable", "esnext"]
  },
  "include": ["../components/ui/**/*.ts", "../components/ui/**/*.tsx"],
  "exclude": ["../node_modules"]
}
